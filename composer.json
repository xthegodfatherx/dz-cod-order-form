{
	"name": "xthegodfatherx/dz-cod-order-form",
	"description": "Cash-on-delivery order form for Algerian WooCommerce stores.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^2.0",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"test:unit": "php tests/unit/run.php",
		"test:integration": "phpunit",
		"lint": "phpcs",
		"test": [
			"@test:unit",
			"@test:integration"
		],
		"lint:fix": "phpcbf"
	}
}
